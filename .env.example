# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# .env.local is gitignored — it never goes to GitHub.

# Supabase → Project Settings → API Keys (or Data API) → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
# (the legacy "anon" key also works). This key is public by design;
# Row Level Security in the database is what protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never put the Supabase secret / service_role key here with a NEXT_PUBLIC_ prefix.
